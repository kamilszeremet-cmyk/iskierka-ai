NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PORT=3000
HOST=127.0.0.1

# TTS local: windows, azure albo off.
TTS_PROVIDER=windows

# Opcjonalnie dla produkcyjnego glosu neuralnego w deployu:
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=pl-PL-ZofiaNeural

# Monetyzacja i beta:
FREE_DAILY_LIMIT=15
PLUS_PRICE_LABEL=29 zł / mies.
PUBLIC_BASE_URL=http://localhost:3000

# Opcjonalnie dla prawdziwego Stripe Checkout:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PLUS_MONTHLY=price_...
